{
  "id": "08",
  "title": "Two-peer multiplayer",
  "checks": [
    {
      "id": "host-join-state",
      "seconds": 90,
      "steps": [
        {
          "action": "fixture",
          "name": "two-peer-host-join-normal-hall"
        },
        {
          "action": "snapshot",
          "as": "joined"
        },
        {
          "action": "assert",
          "actual": "joined.online",
          "op": "eq",
          "expected": true
        },
        {
          "action": "assert",
          "actual": "joined.peer_count",
          "op": "ge",
          "expected": 1
        },
        {
          "action": "assert",
          "actual": "joined.peer_received",
          "op": "gt",
          "expected": 0
        }
      ]
    },
    {
      "id": "quest-state-exchange",
      "seconds": 90,
      "steps": [
        {
          "action": "fixture",
          "name": "two-peer-counter-gate-quest"
        },
        {
          "action": "snapshot",
          "as": "quest"
        },
        {
          "action": "assert",
          "actual": "quest.on_quest",
          "op": "eq",
          "expected": true
        },
        {
          "action": "assert",
          "actual": "quest.active_id",
          "op": "eq",
          "expected": {
            "parameter": "multiplayer-quest-id"
          }
        },
        {
          "action": "assert",
          "actual": "quest.peer_quest_id",
          "op": "eq",
          "expected": {
            "from": "quest.active_id"
          }
        },
        {
          "action": "assert",
          "actual": "quest.peer_state_changes",
          "op": "gt",
          "expected": 0
        },
        {
          "action": "assert",
          "actual": "quest.fast_forward",
          "op": "eq",
          "expected": false
        },
        {
          "action": "assert",
          "actual": "quest.fast_loading",
          "op": "eq",
          "expected": false
        }
      ]
    },
    {
      "id": "disconnect",
      "seconds": 90,
      "steps": [
        {
          "action": "fixture",
          "name": "two-peer-disconnect"
        },
        {
          "action": "snapshot",
          "as": "disconnected"
        },
        {
          "action": "assert",
          "actual": "disconnected.peer_count",
          "op": "eq",
          "expected": 0
        },
        {
          "action": "assert",
          "actual": "disconnected.online",
          "op": "eq",
          "expected": false
        }
      ]
    }
  ]
}
